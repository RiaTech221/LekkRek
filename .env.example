# ==============================================================================
# Modèle d'environnement LekkRek (.env.example)
#
# Instructions pour les membres de l'équipe :
# 1. Copiez ce fichier vers un fichier nommé .env :
#    cp .env.example .env
# 2. Remplissez ou adaptez les variables ci-dessous si nécessaire.
# 3. Le fichier .env est ignoré par Git et ne sera jamais commité.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de données MySQL
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/lekkrek_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=lekkrek_app
DB_PASSWORD=lekkrek_app_password
MYSQL_DATABASE=lekkrek_db
MYSQL_ROOT_PASSWORD=root_change_me_in_prod

# ------------------------------------------------------------------------------
# 2. Sécurité & Authentification JWT
# ------------------------------------------------------------------------------
# Clé secrète de signature des tokens JWT (minimum 256 bits / 32 caractères)
JWT_SECRET=LekkRekDevSecretKeyMustBeAtLeast256BitsLongForHS256Algorithm!!
JWT_EXPIRATION_MS=14400000

# ------------------------------------------------------------------------------
# 3. Passerelle de Paiement PayTech (Wave, Orange Money, Free Money, CB)
# Renseignez ici vos clés API PayTech de test (sandbox) ou de production.
# Obtenez vos clés sur https://paytech.sn
# ------------------------------------------------------------------------------
PAYTECH_API_KEY=votre_cle_api_paytech_ici
PAYTECH_API_SECRET=votre_cle_secrete_paytech_ici
PAYTECH_ENV=test
PAYTECH_IPN_URL=https://lekkrek.com/api/v1/public/payments/ipn
PAYTECH_SUCCESS_URL=http://localhost:5173/?payment=success
PAYTECH_CANCEL_URL=http://localhost:5173/?payment=cancel

# ------------------------------------------------------------------------------
# 4. Frontend React / Vite
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080
