# Variables d'environnement pour le backend LekkRek
# Copiez ce fichier vers ../.env (à la racine) ou .env (dans ce dossier)
DB_URL=jdbc:mysql://localhost:3306/lekkrek_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=lekkrek_app
DB_PASSWORD=lekkrek_app_password
JWT_SECRET=LekkRekDevSecretKeyMustBeAtLeast256BitsLongForHS256Algorithm!!
JWT_EXPIRATION_MS=14400000

# PayTech (Wave, Orange Money, etc.)
PAYTECH_API_KEY=votre_cle_api_paytech_ici
PAYTECH_API_SECRET=votre_cle_secrete_paytech_ici
PAYTECH_ENV=test
PAYTECH_IPN_URL=https://lekkrek.com/api/v1/public/payments/ipn
PAYTECH_SUCCESS_URL=http://localhost:5173/?payment=success
PAYTECH_CANCEL_URL=http://localhost:5173/?payment=cancel
