# 1. Build de l'application React
# Node 22 LTS : vite-plugin-pwa 1.x (terser) exige Node ≥ 20 (« crypto is not defined » sous Node 18)
FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# API_URL reste vide : les fetch utilisent déjà des chemins relatifs /api/v1/…
# et Nginx proxy /api/ vers le backend → même origine, le cookie HttpOnly est
# envoyé automatiquement (l'ancienne valeur /api/v1 doublonnait le préfixe).
ENV VITE_API_URL=
RUN npm run build

# 2. Serveur Nginx
FROM nginx:alpine

# openssl : génération du certificat auto-signé temporaire (avant Let's Encrypt)
RUN apk add --no-cache openssl

# Copie de la configuration Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Sélection du certificat HTTPS au démarrage (exécuté par l'entrypoint nginx).
# sed : retire d'éventuels retours chariot Windows (CRLF) qui casseraient le script.
COPY docker-entrypoint.d/40-lekkrek-ssl.sh /docker-entrypoint.d/40-lekkrek-ssl.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-lekkrek-ssl.sh \
    && chmod +x /docker-entrypoint.d/40-lekkrek-ssl.sh \
    && mkdir -p /var/www/certbot

# Copie des fichiers statiques générés
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
