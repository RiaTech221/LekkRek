# 1. Build de l'application React
FROM node:18-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# API_URL reste vide : les fetch utilisent déjà des chemins relatifs /api/v1/…
# et Nginx proxy /api/ vers le backend → même origine, le cookie HttpOnly est
# envoyé automatiquement (l'ancienne valeur /api/v1 doublonnait le préfixe).
ENV VITE_API_URL=
RUN npm run build

# 2. Serveur Nginx
FROM nginx:alpine

# Copie de la configuration Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copie des fichiers statiques générés
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
